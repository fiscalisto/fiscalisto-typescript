{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"types": []
	},
	"include": ["src"]
}
