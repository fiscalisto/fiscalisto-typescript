{
	"name": "fiscalisto",
	"version": "0.1.0",
	"description": "SDK de la API de facturación electrónica (CFDI 4.0) de Fiscalisto, para TypeScript y JavaScript.",
	"keywords": [
		"cfdi",
		"factura",
		"facturacion",
		"sat",
		"mexico",
		"timbrado",
		"fiscalisto"
	],
	"homepage": "https://fiscalisto.com/docs/api/sdk",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RVP97/invoices-retriever.git",
		"directory": "sdk/typescript"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"prepublishOnly": "npm run build"
	}
}
