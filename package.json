{
	"name": "fiscalisto",
	"version": "0.1.14",
	"description": "SDK y CLI de la API de facturación electrónica (CFDI 4.0) de Fiscalisto, para TypeScript y JavaScript.",
	"keywords": [
		"cfdi",
		"factura",
		"facturacion",
		"sat",
		"mexico",
		"timbrado",
		"fiscalisto",
		"invoicing",
		"e-invoicing",
		"cfdi-4",
		"mexico-invoicing",
		"mcp"
	],
	"homepage": "https://fiscalisto.com/docs/api/sdk",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fiscalisto/fiscalisto-typescript.git"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./mock": {
			"types": "./dist/mock.d.ts",
			"default": "./dist/mock.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"prepublishOnly": "npm run build"
	},
	"bin": {
		"fiscalisto": "dist/cli.js"
	},
	"devDependencies": {
		"@types/node": "^20.19.37",
		"typescript": "^6.0.2"
	}
}
